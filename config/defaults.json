{
  "port": 3101,
  "registry": "http://172.28.0.4:3099",
  "defaultStandard": "a2a-v0.6",
  "defaultTestMode": "blackbox",
  "defaultFramework": "auto",
  "timeout": 30000,
  "maxConcurrent": 5,
  "resultsDir": "./data/eval-results",
